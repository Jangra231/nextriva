# Nexriva environment configuration
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=mysql://user:password@localhost:3306/nexriva

# Authentication
SESSION_SECRET=your-session-secret-here

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# Event Provider APIs (optional - worldwide events will work without these)
# Eventful: https://developer.eventful.com/
EVENTFUL_API_KEY=your-eventful-api-key

# Fever: https://developer.fever.com/
FEVER_API_KEY=your-fever-api-key
FEVER_CLIENT_SECRET=your-fever-client-secret

# Eventbrite: https://www.eventbrite.com/platform/api
EVENTBRITE_API_TOKEN=EAF7BA3WBQEJEECD5JLZ

# Bandsintown: https://developers.bandsintown.com/
BANDSINTOWN_APP_NAME=your-app-name
BANDSINTOWN_API_VERSION=2.0

# Ticketmaster: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=I9N005iqmMfXMVwaXLrzBY7wwyGcZXJj

# Meetup: https://www.meetup.com/api/
MEETUP_API_KEY=your-meetup-api-key
MEETUP_CLIENT_SECRET=your-meetup-client-secret

# Luma: https://api.lu.ma/
LUMA_API_KEY=your-luma-api-key